# Use the project root URL, for example https://your-project-ref.supabase.co
# Do not use the REST endpoint URL ending in /rest/v1.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=

# Server-only. Never prefix these with NEXT_PUBLIC_.
GEMINI_API_KEY=
GOOGLE_API_KEY=
# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=
